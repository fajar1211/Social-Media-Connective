# ─── Backend API ─────────────────────────────────────────
# URL wa-bot-server (production: https://bot.domain.com)
VITE_BOT_API_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────
# Project URL dan Anon Key dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Site URL ────────────────────────────────────────────
# Domain tempat frontend diakses (opsional — fallback untuk OAuth redirect)
VITE_SITE_URL=https://chatconnectpro.marketingconnective.com
