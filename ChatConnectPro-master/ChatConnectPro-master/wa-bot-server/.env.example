# ─── Server ─────────────────────────────────────────────
PORT=3000
LOG_DIR=logs                    # Direktori log files (Fase 10)
LOG_LEVEL=info                  # Log level: info, warn, error, debug

# ─── Supabase ────────────────────────────────────────────
# Project URL, Anon Key, dan Service Role Key dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connection string untuk auto-migration (opsional, untuk npm run migrate)
# Dapatkan dari Supabase Dashboard > Project Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── AI ──────────────────────────────────────────────────
# Google Gemini AI (wajib diisi salah satu)
GEMINI_API_KEY=your-gemini-api-key

# Groq AI (fallback jika Gemini tidak diisi)
# GROQ_API_KEY=your-groq-api-key

# ─── Monitoring & Alert ────────────────────────────────
# URL webhook untuk notifikasi jika bot disconnect (opsional)
# Contoh: https://hooks.slack.com/services/xxx atau URL webhook lain
# ALERT_WEBHOOK_URL=https://hooks.example.com/alert

# ─── WhatsApp (opsional untuk development) ──────────────
# WhatsApp session akan auto-restore dari folder wa_auth/
# Tidak perlu konfigurasi tambahan
